# ── Required ─────────────────────────────────────────────────────────────────

# Unique identifier for this installation. Used in telemetry. No spaces.
OTEL_CLIENT_INSTALL_ID=my-install-id

# Claude API key (stored in Secrets Manager in production: arena/claude-api-key)
CLAUDE_API_KEY=

# PostgreSQL connection string
DATABASE_URL=postgresql://arena:arena_local@localhost:5432/arena_dev

# Redis connection string
REDIS_URL=redis://localhost:6379

# ── Required in production (optional in development) ─────────────────────────

# Allowed CORS origin. Required when NODE_ENV=production.
CORS_ORIGIN=https://app.example.com

# Cognito user pool configuration. Required when COGNITO_BYPASS is not true.
COGNITO_USER_POOL_ID=
COGNITO_REGION=us-east-1

# ── Observability (optional — server starts without these) ───────────────────

# OTel / ClickHouse endpoint and credentials for telemetry writes
OTEL_EXPORTER_OTLP_ENDPOINT=
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Override the service name reported in telemetry (default: arena-api)
OTEL_SERVICE_NAME=arena-api

# Salt for pseudonymising PII in logs. Set a random value in non-dev environments.
LOG_HASH_SALT=change-me-in-production

# ── Development bypasses (never set these in production) ─────────────────────

# Skip Cognito JWT validation and inject a mock user
COGNITO_BYPASS=true
COGNITO_MOCK_USER_ID=00000000-0000-4000-a000-000000000001
COGNITO_MOCK_GROUPS=admin

# Skip ElevenLabs STT/TTS calls and return canned responses
ELEVENLABS_MOCK=true
ELEVENLABS_API_KEY=mock

# Skip consent check in startInterview
CONSENT_BYPASS=true

# ── Optional ──────────────────────────────────────────────────────────────────

# Log level (default: info)
LOG_LEVEL=info

# Fastify listen address and port (defaults: 0.0.0.0, 3001)
HOST=0.0.0.0
PORT=3001

# S3 bucket for audio segments and the AWS region it lives in
S3_AUDIO_BUCKET=
AWS_REGION=us-east-1

# EventBridge bus name (default: arena-event-bus)
EVENT_BUS_NAME=arena-event-bus
