# ── Required ─────────────────────────────────────────────────────────────────

# GraphQL API endpoint
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:3001/graphql

# REST/SSE API base URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# WebSocket URL for the STT proxy
NEXT_PUBLIC_STT_WS_URL=ws://localhost:3001/stt

# ── Required in production (optional when NEXT_PUBLIC_COGNITO_BYPASS=true) ───

# Cognito user pool configuration
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=

# ── Development bypasses (never set these in production) ─────────────────────

# Skip Cognito auth and inject a mock session
NEXT_PUBLIC_COGNITO_BYPASS=true
